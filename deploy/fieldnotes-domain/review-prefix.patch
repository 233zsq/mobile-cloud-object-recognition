+import re
+from urllib.parse import urlsplit
+from campus_review import create_app
+from review_support import photo
+
+BASE='https://fieldnotes.bigdogaaa.cn/review/'
+FORWARDED={'X-Forwarded-Proto':'https','X-Forwarded-Prefix':'/review'}
+
+def prefixed_app(tmp_path):
+    return create_app({'TESTING':True,'SECRET_KEY':'prefix-test-'*5,'DATA_DIR':str(tmp_path),'APPLICATION_ROOT':'/review'})
+
+def call(client,path,method='GET',data=None):
+    # Nginx strips /review from PATH_INFO and supplies the trusted prefix.
+    return client.open(path,method=method,data=data,base_url=BASE,headers=FORWARDED)
+
+def token(response):
+    return re.search(r'name="csrf"[^>]*value="([^"]+)"',response.text).group(1)
+
+def login(app):
+    invitation=app.test_cli_runner().invoke(args=['bootstrap'])
+    assert invitation.exit_code==0,invitation.output
+    client=app.test_client()
+    path=invitation.output.strip()
+    page=call(client,path)
+    joined=call(client,path,'POST',{'csrf':token(page),'username':'prefix-admin','password':'prefix-test-password-strong'})
+    assert joined.status_code==302 and joined.headers['Location']=='/review/login'
+    page=call(client,'/login')
+    result=call(client,'/login','POST',{'csrf':token(page),'username':'prefix-admin','password':'prefix-test-password-strong'})
+    assert result.status_code==302 and result.headers['Location']=='/review/'
+    return client
+
+def test_prefix_login_static_cookie_and_host_protection(tmp_path):
+    app=prefixed_app(tmp_path);client=app.test_client()
+    index=call(client,'/')
+    assert index.status_code==302 and index.headers['Location']=='/review/login'
+    page=call(client,'/login')
+    assert page.status_code==200
+    assert '/review/static/style.css' in page.text
+    cookie=index.headers['Set-Cookie']
+    assert 'Path=/review' in cookie and 'Secure' in cookie and 'HttpOnly' in cookie and 'SameSite=Lax' in cookie
+    assert call(client,'/static/style.css').status_code==200
+    assert client.get('/health',base_url='https://evil.example').status_code==400
+
+def test_prefix_authentication_csrf_and_upload_image_cycle(tmp_path):
+    app=prefixed_app(tmp_path);client=login(app)
+    assert call(client,'/').status_code==200
+    assert call(client,'/upload','POST',{}).status_code==400
+    page=call(client,'/upload')
+    upload=call(client,'/upload','POST',{'csrf':token(page),'image':(photo(),'prefix.jpg'),'object_id':'prefix-cup','session_id':'prefix-session','category':'0'})
+    assert upload.status_code==302 and upload.headers['Location'].startswith('/review/samples/')
+    sid=upload.headers['Location'].rsplit('/',1)[1]
+    assert call(client,'/samples/'+sid).status_code==200
+    image=call(client,'/images/'+sid+'?size=thumb')
+    assert image.status_code==200 and image.mimetype=='image/webp'
+    anonymous=app.test_client()
+    denied=call(anonymous,'/images/'+sid)
+    assert denied.status_code==302 and denied.headers['Location']=='/review/login'
+
+def test_prefix_absolute_invitation_and_logout(tmp_path):
+    app=prefixed_app(tmp_path);client=login(app)
+    page=call(client,'/')
+    invitation=call(client,'/invites','POST',{'csrf':token(page)})
+    assert invitation.status_code==200 and 'https://fieldnotes.bigdogaaa.cn/review/join/' in invitation.text
+    logout=call(client,'/logout','POST',{'csrf':token(call(client,'/'))})
+    assert logout.status_code==302 and logout.headers['Location']=='/review/login'
+    assert call(client,'/').headers['Location']=='/review/login'
