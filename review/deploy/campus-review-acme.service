[Unit]
Description=Renew trusted IP certificate for campus review on 8443
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/campus-review-acme.py renew
ExecStopPost=/usr/bin/python3 /usr/local/libexec/campus-review-acme.py restore
UMask=0077
PrivateTmp=true
TimeoutStartSec=900
