# Flask reads the repository-root .env; process environment variables take priority.
# Copy to .env for local configuration; never commit real credentials.
APP_VERSION=0.1.0
APP_DEBUG=false
LOG_LEVEL=INFO
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Request body limit in bytes (10 MiB); image validation follows in inference work.
MAX_CONTENT_LENGTH=10485760
# Reserved configuration: database/authentication/model loading are not implemented yet.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=object_recognition
DB_USER=object_recognition
DB_PASSWORD=
API_TOKEN=
API_BASE_URL=http://localhost:8080
MODEL_DIR=
