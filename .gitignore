# Original photos and generated datasets (keep manifests and split lists)
/data/raw/**
!/data/raw/.gitkeep
/data/processed/**
!/data/processed/.gitkeep

# Model binaries and training outputs; metadata remains trackable
*.tflite
*.keras
*.h5
*.hdf5
*.onnx
*.pt
*.pth
*.ckpt
*.ckpt.*
/models/**/saved_model/
/experiments/checkpoints/**
!/experiments/checkpoints/.gitkeep
/experiments/logs/**
!/experiments/logs/.gitkeep

# Preview contact sheets include raw candidate photos and attribution stays in manifests
/experiments/reports/audit/*.png
/experiments/reports/evaluations/*/*-errors.png
/models/releases/**/examples/*.jpg
/models/releases/**/examples/*.jpeg
/models/releases/**/examples/*.png
/models/releases/**/examples/*.webp
/models/releases/**/examples/*.bin

# Large delivery archives and recordings; store separately
*.zip
*.7z
*.tar
*.tar.gz
*.mp4
*.mov
*.avi
*.mkv
