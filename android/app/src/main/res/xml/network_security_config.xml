<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置（替代 Manifest 上的 usesCleartextTraffic 布尔开关，便于逐域控制）。

  - base-config：默认信任系统 CA；联调期保留明文 http（局域网联调），后端全面转 HTTPS 后改为 false。
  - domain-config：正式入口 fieldnotes.bigdogaaa.cn 使用公开证书，只信任系统 CA；
    旧 IP 49.232.195.47 仍保留短期 IP 证书（自动续期），供已安装的旧版本回退。
    raw/team_server_cert 是旧自签证书，仅保留用于原部署回退；更换域名时重新检查域名配置。
  - debug-overrides：仅 debug 构建生效，额外信任设备上用户安装的 CA，
    便于局域网/自签环境联调；release 构建不受影响。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config>
        <domain includeSubdomains="false">fieldnotes.bigdogaaa.cn</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <domain-config>
        <domain includeSubdomains="false">49.232.195.47</domain>
        <trust-anchors>
            <certificates src="@raw/team_server_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
