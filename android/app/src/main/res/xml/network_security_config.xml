<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置（替代 Manifest 上的 usesCleartextTraffic 布尔开关，便于逐域控制）。

  - base-config：默认信任系统 CA；联调期保留明文 http（局域网联调），后端全面转 HTTPS 后改为 false。
  - domain-config：组内腾讯云实例 49.232.195.47 使用 IP 自签名证书（deploy/certs/server.crt，
    SAN 含该 IP，有效期至 2027-01-06）。这里显式信任该公钥证书，不依赖设备安装。
    服务器换证书或换 IP 时同步更新 deploy/certs/server.crt 与本文件。
  - debug-overrides：仅 debug 构建生效，额外信任设备上用户安装的 CA，
    便于局域网/自签环境联调；release 构建不受影响。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config>
        <domain includeSubdomains="false">49.232.195.47</domain>
        <trust-anchors>
            <certificates src="@raw/team_server_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>